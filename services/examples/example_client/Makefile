.PHONY: help venv run run-vault run-direct clean health

SERVICE_NAME := example_client
GRPC_PORT := 8080
VAULT_ENABLED := False
VAULT_ADDR := "http://localhost:8200"
VAULT_TOKEN := "root"

VENV_DIR := venv
PYTHON := $(VENV_DIR)/bin/python
PIP := $(VENV_DIR)/bin/pip

SHOW_VAULT_LOG ?= 0

  ifeq ($(SHOW_VAULT_LOG),1)
    VAULT_REDIRECT :=
  else
    VAULT_REDIRECT := 2>/dev/null
  endif

# Colors for output
GREEN := \033[0;32m
RED := \033[0;31m
YELLOW := \033[0;33m
NC := \033[0m # No Color

help:
	@echo "$(GREEN)Available commands:$(NC)"
	@echo "  $(YELLOW)make venv$(NC)            - Create virtualenv and install deps"
	@echo "  $(YELLOW)make run$(NC)             - Run via virtualenv"
	@echo "  $(YELLOW)make run SHOW_VAULT_LOG=1$(NC) - Run with Vault Agent logs visible"
	@echo "  $(YELLOW)make run-direct$(NC)      - Run directly without Vault"
	@echo "  $(YELLOW)make clean$(NC)           - Clean generated files and venv"
	@echo "  $(YELLOW)make health$(NC)          - Check service health"
	@echo ""
	@echo "Configuration:"
	@echo "  Service: $(GREEN)$(SERVICE_NAME)$(NC)"
	@echo "  gRPC port: $(GREEN)$(GRPC_PORT)$(NC)"

venv:
	@echo "$(GREEN)Creating virtualenv in $(VENV_DIR)...$(NC)"
	python3 -m venv $(VENV_DIR)
	$(PIP) install -r generated/requirements.txt
	@echo "$(GREEN)Done. Activate with: source $(VENV_DIR)/bin/activate$(NC)"


check-venv:
	@if [ ! -f $(PYTHON) ]; then \
		echo "$(YELLOW)Virtualenv not found, creating...$(NC)"; \
		$(MAKE) venv; \
	fi

run: check-venv
	@echo "$(GREEN)Running $(SERVICE_NAME)...$(NC)"
	@echo "$(YELLOW)Running directly...$(NC)"
	$(PYTHON) generated/main.py

run-direct: check-venv
	@echo "$(GREEN)Running $(SERVICE_NAME) directly...$(NC)"
	$(PYTHON) generated/main.py

health:
	@echo "$(GREEN)Checking service health...$(NC)"
	@OUTPUT=$$(grpcurl -plaintext -max-time 3 localhost:$(GRPC_PORT) grpc.health.v1.Health/Check 2>&1); \
	if [ $$? -eq 0 ]; then \
		echo "$(GREEN)✅ Service is healthy!$(NC)"; \
	else \
		echo "$(RED)❌ Health check failed: $${OUTPUT}$(NC)"; \
	fi

clean:
	@echo "$(GREEN)Cleaning generated files...$(NC)"
	rm -rf generated/
	rm -rf __pycache__/
	rm -rf .pytest_cache/
	rm -rf *.egg-info/
	rm -rf $(VENV_DIR)
	rm -f vault/$(SERVICE_NAME)-role-id.txt vault/$(SERVICE_NAME)-secret-id.txt
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

