FROM python:3.12-slim

WORKDIR /app

# Install protobuf compiler and gRPC tools for code generation at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY generated/requirements.txt /app/generated/requirements.txt
RUN pip install --no-cache-dir -r /app/generated/requirements.txt

# Copy generated code
COPY generated/ /app/generated/

# Copy service root (service.yaml, src/, main.py)
COPY . /app/

CMD ["python", "main.py"]
