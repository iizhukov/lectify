def is_running_under_vault() -> bool:
    """Проверяет, запущено ли приложение под Vault Agent"""
    try:
        subprocess.run(["vault", "--version"], capture_output=True, check=False)
    except FileNotFoundError:
        return False
    
    config_path = Path("/vault/agent-{{ service.name }}.hcl")
    if not config_path.exists():
        return False
    
    return os.environ.get("VAULT_TOKEN") is not None or os.environ.get("VAULT_ADDR") is not None
