.PHONY: help venv run run-vault run-direct clean health

SERVICE_NAME := {{ service.name }}
GRPC_PORT := {{ service.grpc.port }}
VAULT_ENABLED := {{ service.vault.enabled }}
{% if service.vault.enabled %}
VAULT_CONFIG := generated/vault/agent-{{ service.name }}.local.hcl
{% endif %}
VAULT_ADDR := "http://localhost:{{ settings.VAULT_PORT }}"
VAULT_TOKEN := "{{ settings.VAULT_DEV_ROOT_TOKEN_ID }}"

VENV_DIR := venv
PYTHON := $(VENV_DIR)/bin/python
PIP := $(VENV_DIR)/bin/pip
REQUIREMENTS_FILE := generated/requirements.txt
REQUIREMENTS_CHECKSUM := $(VENV_DIR)/.requirements.checksum

SHOW_VAULT_LOG ?= 0

  ifeq ($(SHOW_VAULT_LOG),1)
    VAULT_REDIRECT :=
  else
    VAULT_REDIRECT := 2>/dev/null
  endif

# Colors for output
GREEN := \033[0;32m
RED := \033[0;31m
YELLOW := \033[0;33m
NC := \033[0m # No Color

help:
	@echo "$(GREEN)Available commands:$(NC)"
	@echo "  $(YELLOW)make venv$(NC)            - Create virtualenv and install deps"
	@echo "  $(YELLOW)make run$(NC)             - Run via virtualenv"
	@echo "  $(YELLOW)make run SHOW_VAULT_LOG=1$(NC) - Run with Vault Agent logs visible"
	@echo "  $(YELLOW)make run-direct$(NC)      - Run directly without Vault"
	@echo "  $(YELLOW)make clean$(NC)           - Clean generated files and venv"
	@echo "  $(YELLOW)make check-requirements$(NC) - Update deps if requirements.txt changed"
	@echo "  $(YELLOW)make health$(NC)          - Check service health"
{% if service.vault.enabled %}
	@echo "  $(YELLOW)make run-vault SHOW_VAULT_LOG=1$(NC)    - Run with Vault Agent"
	@echo "  $(YELLOW)make vault-init$(NC)      - Initialize Vault for this service"
{% endif %}
	@echo ""
	@echo "Configuration:"
	@echo "  Service: $(GREEN)$(SERVICE_NAME)$(NC)"
	@echo "  gRPC port: $(GREEN)$(GRPC_PORT)$(NC)"
{% if service.vault.enabled %}
	@echo "  Vault enabled: $(GREEN)$(VAULT_ENABLED)$(NC)"
{% endif %}

venv:
	@echo "$(GREEN)Creating virtualenv in $(VENV_DIR)...$(NC)"
	python3 -m venv $(VENV_DIR)
	$(PIP) install -r $(REQUIREMENTS_FILE)
	$(shell mkdir -p $(VENV_DIR))
	@md5sum $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || md5 -r $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || true
	@echo "$(GREEN)Done. Activate with: source $(VENV_DIR)/bin/activate$(NC)"

{% if service.vault.enabled %}

check-vault:
	@command -v VAULT_ADDR="${VAULT_ADDR}" VAULT_TOKEN="${VAULT_TOKEN}" vault >/dev/null 2>&1 || { echo "$(RED)Vault not found. Install with: brew install hashicorp/tap/vault$(NC)"; exit 1; }

check-vault-config:
	@if [ -f $(VAULT_CONFIG) ]; then \
		echo "$(GREEN)Vault config found$(NC)"; \
	else \
		echo "$(YELLOW)No Vault config found, please run: codegen generate$(NC)"; \
		exit 1; \
	fi

check-secrets:
	@if [ -f vault/$(SERVICE_NAME)-role-id.txt ] && [ -f vault/$(SERVICE_NAME)-secret-id.txt ]; then \
		echo "$(GREEN)Vault secrets found$(NC)"; \
	else \
		echo "$(YELLOW)Vault secrets not found, running vault-init...$(NC)"; \
		$(MAKE) vault-init; \
	fi

vault-init: check-vault
	@echo "$(GREEN)Initializing Vault for $(SERVICE_NAME)...$(NC)"
	@mkdir -p vault
	@if [ -f generated/scripts/init-vault.local.sh ]; then \
		chmod +x generated/scripts/init-vault.local.sh; \
		./generated/scripts/init-vault.local.sh; \
	else \
		echo "$(RED)Init script not found: generated/scripts/init-vault.local.sh$(NC)"; \
		echo "$(YELLOW)Please run: codegen generate$(NC)"; \
		exit 1; \
	fi

run-vault: check-vault check-vault-config check-secrets
	@echo "$(GREEN)Running $(SERVICE_NAME) with Vault Agent...$(NC)"
	VAULT_ADDR="${VAULT_ADDR}" VAULT_TOKEN="${VAULT_TOKEN}" vault agent -config=$(VAULT_CONFIG) $(VAULT_REDIRECT)

{% endif %}

check-requirements:
	@if [ -f $(REQUIREMENTS_CHECKSUM) ] && [ -f $(REQUIREMENTS_FILE) ]; then \
		COMPUTED=$$(md5sum $(REQUIREMENTS_FILE) 2>/dev/null | cut -d' ' -f1 || md5 -r $(REQUIREMENTS_FILE) 2>/dev/null | cut -d' ' -f1); \
		STORED=$$(cat $(REQUIREMENTS_CHECKSUM)); \
		if [ "$$COMPUTED" != "$$STORED" ]; then \
			echo "$(YELLOW)requirements.txt changed, reinstalling dependencies...$(NC)"; \
			$(PIP) install -r $(REQUIREMENTS_FILE); \
			md5sum $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || md5 -r $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || true; \
		fi \
	elif [ -f $(REQUIREMENTS_FILE) ]; then \
		echo "$(YELLOW)Initializing dependency tracking...$(NC)"; \
		$(PIP) install -r $(REQUIREMENTS_FILE); \
		md5sum $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || md5 -r $(REQUIREMENTS_FILE) > $(REQUIREMENTS_CHECKSUM) 2>/dev/null || true; \
	fi

check-venv:
	@if [ ! -f $(PYTHON) ]; then \
		echo "$(YELLOW)Virtualenv not found, creating...$(NC)"; \
		$(MAKE) venv; \
	fi
	@$(MAKE) check-requirements 2>/dev/null || true

run: check-venv
	@echo "$(GREEN)Running $(SERVICE_NAME)...$(NC)"
{% if service.vault.enabled %}
	@if command -v VAULT_ADDR="${VAULT_ADDR}" VAULT_TOKEN="${VAULT_TOKEN}" vault >/dev/null 2>&1 && [ -f $(VAULT_CONFIG) ]; then \
		echo "$(GREEN)Starting with Vault Agent...$(NC)"; \
		$(MAKE) check-secrets; \
		VAULT_ADDR="${VAULT_ADDR}" VAULT_TOKEN="${VAULT_TOKEN}" vault agent -config=$(VAULT_CONFIG) $(VAULT_REDIRECT); \
	else \
		echo "$(YELLOW)Running directly...$(NC)"; \
		$(PYTHON) generated/main.py; \
	fi
{% else %}
	@echo "$(YELLOW)Running directly...$(NC)"
	$(PYTHON) generated/main.py
{% endif %}

run-direct: check-venv
	@echo "$(GREEN)Running $(SERVICE_NAME) directly...$(NC)"
	$(PYTHON) generated/main.py

health:
	@echo "$(GREEN)Checking service health...$(NC)"
	@OUTPUT=$$(grpcurl -plaintext -max-time 3 localhost:$(GRPC_PORT) grpc.health.v1.Health/Check 2>&1); \
	if [ $$? -eq 0 ]; then \
		echo "$(GREEN)✅ Service is healthy!$(NC)"; \
	else \
		echo "$(RED)❌ Health check failed: $${OUTPUT}$(NC)"; \
	fi

clean:
	@echo "$(GREEN)Cleaning generated files...$(NC)"
	rm -rf generated/
	rm -rf __pycache__/
	rm -rf .pytest_cache/
	rm -rf *.egg-info/
	rm -rf $(VENV_DIR)
	rm -f vault/$(SERVICE_NAME)-role-id.txt vault/$(SERVICE_NAME)-secret-id.txt
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

{% if service.vault.enabled %}
clean-secrets:
	@echo "$(GREEN)Cleaning Vault secrets for $(SERVICE_NAME)...$(NC)"
	rm -f vault/$(SERVICE_NAME)-role-id.txt vault/$(SERVICE_NAME)-secret-id.txt
	@echo "$(GREEN)Secrets removed. Run 'make vault-init' to reinitialize.$(NC)"
{% endif %}
